    {
      "id": "flow:XSD_To_OpenAPI_1",
      "data": {
        "name": "XSD_To_OpenAPI_1",
        "description": "Convert XSD Schema to OpenAPI Schema (3.1.x / 3.0.x) with restriction mapping",
        "links": [
          {
            "id": 1,
            "from": "StartActivity",
            "to": "XSDToOpenAPI",
            "type": "label",
            "label": "StartActivity to XSDToOpenAPI"
          },
          {
            "id": 2,
            "from": "XSDToOpenAPI",
            "to": "LogSuccess",
            "type": "expression",
            "label": "XSDToOpenAPI to LogSuccess",
            "value": "$activity[XSDToOpenAPI].error != boolean.true()"
          },
          {
            "id": 3,
            "from": "LogSuccess",
            "to": "Return200",
            "type": "label",
            "label": "LogSuccess to Return200"
          },
          {
            "id": 4,
            "from": "XSDToOpenAPI",
            "to": "LogError",
            "type": "exprOtherwise",
            "label": "XSDToOpenAPI to LogError"
          },
          {
            "id": 5,
            "from": "LogError",
            "to": "Return500",
            "type": "label",
            "label": "LogError to Return500"
          }
        ],
        "tasks": [
          {
            "id": "StartActivity",
            "name": "StartActivity",
            "description": "NoOp Activity",
            "activity": {
              "ref": "#noop"
            }
          },
          {
            "id": "XSDToOpenAPI",
            "name": "XSDToOpenAPI",
            "description": "Converts XSD Schema into an OpenAPI document (components.schemas) with equivalent restriction mapping",
            "activity": {
              "ref": "#xsdschematransform",
              "input": {
                "xsdString": "=coerce.toString($flow.multipartFormData.file[0])",
                "outputFormat": "openapi",
                "validateInput": false,
                "preserveOrder": false,
                "optimizeOutput": false,
                "jsonSchemaVersion": "2020-12",
                "jsonSchemaTitle": "",
                "jsonSchemaId": "",
                "addExamples": false,
                "avroRecordName": "RootRecord",
                "avroNamespace": "com.example",
                "avroLogicalTypes": false,
                "avroUnionMode": "nullable",
                "handleAny": "object",
                "handleChoice": "union",
                "includeAttributes": true,
                "namespaceHandling": "ignore",
                "complexTypeMode": "inline",
                "openApiVersion": "3.1.0",
                "openApiSchemaName": "RootSchema",
                "openApiTitle": "",
                "openApiInfoVersion": "1.0.0",
                "strictAdditionalProperties": false
              }
            }
          },
          {
            "id": "LogSuccess",
            "name": "LogSuccess",
            "description": "Log successful OpenAPI conversion",
            "activity": {
              "ref": "#log",
              "input": {
                "Log Level": "INFO",
                "flowInfo": false,
                "message": "=string.concat(\"###### Transformed XSD to OpenAPI - \", coerce.toString($activity[XSDToOpenAPI]))",
                "logLevel": ""
              }
            }
          },
          {
            "id": "Return200",
            "name": "Return200",
            "description": "Return 200 with generated OpenAPI document",
            "activity": {
              "ref": "#actreturn",
              "settings": {
                "mappings": {
                  "code": 200,
                  "data": "=coerce.toObject($activity[XSDToOpenAPI].openApiSchemaString)"
                }
              }
            }
          },
          {
            "id": "LogError",
            "name": "LogError",
            "description": "Log conversion error",
            "activity": {
              "ref": "#log",
              "input": {
                "Log Level": "INFO",
                "flowInfo": false,
                "message": "=string.concat(\"###### ERROR in XSD to OpenAPI Conversion - \", $activity[XSDToOpenAPI].errorMessage)",
                "logLevel": ""
              }
            }
          },
          {
            "id": "Return500",
            "name": "Return500",
            "description": "Return 500 with error details",
            "activity": {
              "ref": "#actreturn",
              "settings": {
                "mappings": {
                  "code": 500,
                  "data": "=$activity[XSDToOpenAPI]"
                }
              }
            }
          }
        ],
