              },
              "body": {
                "type": "json",
                "value": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"properties\":{\"xsd\":{\"type\":\"string\"}}}",
                "fe_metadata": "{\n    \"xsd\":\"\"\n}"
              }
            }
          },
          "name": "XSD_To_to_Other_Schema_Format"
        },
