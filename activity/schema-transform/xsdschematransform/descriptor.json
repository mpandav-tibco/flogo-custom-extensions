{
  "name": "xsdschematransform",
  "type": "flogo:activity",
  "version": "1.0.0",
  "title": "XSD Schema Transform",
  "image": "icons/xsd-schema-transform.svg",
  "description": "Comprehensive XSD Schema transformation activity supporting conversion to JSON Schema and Avro Schema with extensive feature coverage",
  "author": "Flogo Custom Extensions",
  "homepage": "https://github.com/project-flogo/contrib/tree/master/activity/xsdschematransform",
  "display": {
    "category": "xsdschematransform",
    "visible": true,
    "smallIcon": "icons/xsd-schema-transform.svg",
    "description": "Convert XSD schema to JSON Schema or Avro"
  },
  "settings": [],
  "inputs": [
    {
      "name": "xsdString",
      "type": "string",
      "required": true,
      "description": "XSD schema string to transform"
    },
    {
      "name": "outputFormat",
      "type": "string",
      "description": "Output format: 'jsonschema', 'avro', 'openapi', or 'both' (jsonschema+avro)",
      "value": "both"
    },
    {
      "name": "validateInput",
      "type": "boolean",
      "description": "Validate XSD schema before conversion",
      "value": false
    },
    {
      "name": "preserveOrder",
      "type": "boolean",
      "description": "Preserve element order when possible",
      "value": false
    },
    {
      "name": "optimizeOutput",
      "type": "boolean",
      "description": "Optimize output schema structure",
      "value": false
    },
    {
      "name": "jsonSchemaVersion",
      "type": "string",
      "description": "JSON Schema version: 'draft-04', 'draft-07', '2019-09', '2020-12'",
      "value": "2020-12"
    },
    {
      "name": "jsonSchemaTitle",
      "type": "string",
      "description": "JSON Schema title"
    },
    {
      "name": "jsonSchemaId",
      "type": "string",
      "description": "JSON Schema $id"
    },
    {
      "name": "addExamples",
      "type": "boolean",
      "description": "Add example values from XSD",
      "value": false
    },
    {
      "name": "avroRecordName",
      "type": "string",
      "description": "Root record name for Avro schema",
      "value": "RootRecord"
    },
    {
      "name": "avroNamespace",
      "type": "string",
      "description": "Namespace for Avro schema",
      "value": "com.example"
    },
    {
      "name": "avroLogicalTypes",
      "type": "boolean",
      "description": "Enable Avro logical types (date, time, decimal, etc.)",
      "value": false
    },
    {
      "name": "avroUnionMode",
      "type": "string",
      "description": "Avro union handling: 'nullable', 'strict', 'permissive'",
      "value": "nullable"
    },
    {
      "name": "handleAny",
      "type": "string",
      "description": "How to handle xs:any elements: 'object', 'string', 'ignore'",
      "value": "object"
    },
    {
      "name": "handleChoice",
      "type": "string",
      "description": "How to handle xs:choice: 'union', 'oneof', 'anyof'",
      "value": "union"
    },
    {
      "name": "includeAttributes",
      "type": "boolean",
      "description": "Include XML attributes in conversion",
      "value": true
    },
    {
      "name": "namespaceHandling",
      "type": "string",
      "description": "Namespace handling: 'ignore', 'prefix', 'separate'",
      "value": "ignore"
    },
    {
      "name": "complexTypeMode",
      "type": "string",
      "description": "Complex type handling: 'inline', 'definitions', 'refs'",
      "value": "inline"
    },
    {
      "name": "openApiVersion",
      "type": "string",
      "description": "OpenAPI Schema Object dialect: '3.1.0' (default, full JSON Schema 2020-12) or '3.0.3' (nullable flag, boolean exclusiveMin/Max)",
      "value": "3.1.0"
    },
    {
      "name": "openApiSchemaName",
      "type": "string",
      "description": "Name of the root schema entry under components.schemas",
      "value": "RootSchema"
    },
    {
      "name": "openApiTitle",
      "type": "string",
      "description": "OpenAPI document info.title (defaults to openApiSchemaName)"
    },
    {
      "name": "openApiInfoVersion",
      "type": "string",
      "description": "OpenAPI document info.version",
      "value": "1.0.0"
    },
    {
      "name": "strictAdditionalProperties",
      "type": "boolean",
      "description": "Set additionalProperties:false on XSD complex types with no xs:any/xs:anyAttribute wildcard (matches XSD's implicit closed content model); opt-in, off by default to preserve existing output",
      "value": false
    }
  ],
  "outputs": [
    {
      "name": "jsonSchemaString",
      "type": "string",
      "description": "Generated JSON Schema string"
    },
    {
      "name": "avroSchemaString",
      "type": "string",
      "description": "Generated Avro Schema string"
    },
    {
      "name": "openApiSchemaString",
      "type": "string",
      "description": "Generated OpenAPI document (components.schemas) string"
    },
    {
      "name": "validationResult",
      "type": "string",
      "description": "XSD validation result (JSON string)"
    },
    {
      "name": "conversionStats",
      "type": "string",
      "description": "Conversion statistics (JSON string)"
    },
    {
      "name": "error",
      "type": "boolean",
      "description": "Whether an error occurred during conversion"
    },
    {
      "name": "errorMessage",
      "type": "string",
      "description": "Error message if error occurred"
    }
  ]
}